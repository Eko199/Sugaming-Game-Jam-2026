layout_mode = 2
theme_override_colors/default_color = Color(0, 0, 0, 1)
theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "[font_size=48]Serve[/font_size]
Right ingredients + Right heat + Right stir = Magnificent potion & maximum gold!

Right ingredients, wrong heat/stir = Good or Poor potion (less gold).

Wrong ingredients = BOOM! The cauldron explodes with toxic fumes and hits you with a random Debuff:
[img width=80 height=80]res://textures/shuffle.png[/img]Shelf Shuffle: Your ingredients randomly swap places on the shelf!
[img width=80 height=80]res://textures/blindness.png[/img]Color Blindness: The whole room and the heroes turn black and white!
[img width=80 height=80]res://textures/gibberish.png[/img]Gibberish: Customer orders get their letters scrambled!"
fit_content = true
vertical_alignment = 1

