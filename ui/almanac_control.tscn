theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "[font_size=48]Toss Ingredients[/font_size]
Grab 1 to 3 items from the shelf and drop them into the cauldron. Since the book is ruined, you'll have to guess and write down the recipe."
fit_content = true
vertical_alignment = 1

[node name="Label3" type="RichTextLabel" parent="Tutorial/HBoxContainer/VBoxContainer" unique_id=1916306746]
