theme_override_font_sizes/normal_font_size = 40
bbcode_enabled = true
text = "[font_size=48]16.10.1467[/font_size]
Hard times have come. A massive Dragon suddenly appeared from the mountain and attacked the village!"
fit_content = true
vertical_alignment = 1

[node name="Label3" type="RichTextLabel" parent="Diary/HBoxContainer/VBoxContainer2" unique_id=597667779]
custom_minimum_size = Vector2(650, 100)
